{
  "description": "m-skills lifecycle hooks. Four SessionStart context hooks, three PreToolUse guards enforcing the rules the skills previously only stated, three advisories, and a pick check that holds the turn open until a skill picked in the picker has its SKILL.md loaded. Guards honour .claude/.m-skills-no-guards (project) or the same file in $CLAUDE_CONFIG_DIR (global); the skill-suggestion hook honours .m-skills-no-suggest at either scope, and the adhd hook is opt-in rather than opt-out.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/profile-bootstrap.sh"],
            "timeout": 20,
            "statusMessage": "m-skills: checking for PROJECT-PROFILE.md..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/adhd-always-on.sh"],
            "timeout": 10,
            "statusMessage": "m-skills: checking adhd always-on flag..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/resume-progress.sh"],
            "timeout": 10,
            "statusMessage": "m-skills: checking for an unfinished run..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/suggest-skills.sh"],
            "timeout": 10,
            "statusMessage": "m-skills: loading skill suggestions..."
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/profile-bootstrap.sh"],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-mutations.sh"],
            "timeout": 10,
            "statusMessage": "m-skills: checking git and golden-file guards..."
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-outward.sh"],
            "timeout": 5,
            "statusMessage": "m-skills: checking for outward-facing actions..."
          }
        ]
      },
      {
        "matcher": "Read|Grep|Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-secrets.sh"],
            "timeout": 5,
            "statusMessage": "m-skills: checking for secret-bearing paths..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/skill-preamble.sh"],
            "timeout": 15,
            "statusMessage": "m-skills: resolving gates and guidelines..."
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/enforce-picks.sh"],
            "timeout": 10,
            "statusMessage": "m-skills: checking the pick for a skill to start..."
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/enforce-picks.sh"],
            "timeout": 15,
            "statusMessage": "m-skills: checking for a picked skill being loaded..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/warn-test-weakening.sh"],
            "timeout": 5,
            "statusMessage": "m-skills: checking for new skip markers..."
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/advise-propagation.sh"],
            "timeout": 5,
            "statusMessage": "m-skills: checking for shared-shape edits..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/enforce-picks.sh"],
            "timeout": 10,
            "statusMessage": "m-skills: checking for a picked skill never loaded..."
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/skill-preamble.sh"],
            "timeout": 15,
            "statusMessage": "m-skills: resolving gates and guidelines..."
          }
        ]
      }
    ]
  }
}
