{
  "_comment": "Portable permission allowlist for this skills pack. Copy to .claude/settings.local.json in a new project. Read-only inspection and the standard gate commands are pre-allowed. The deny list is a SUBSET backstop for a copy-the-skills install with no hook wiring — it is not a mirror of the plugin's guards, because prefix matching cannot see inside `cd x && git commit`, cannot catch --no-verify, and cannot express \"the writing forms of git branch but not the listing ones\". Only unambiguous writes are listed here; guard-mutations.sh and guard-outward.sh cover the rest. Read-only git and gh stay allowed, including the listing forms of branch/tag/stash/remote/worktree per guidelines-meta §9 — the code-review path is built on them.",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(npm run *)",
      "Bash(npm test:*)",
      "Bash(npm audit:*)",
      "Bash(pnpm run *)",
      "Bash(pnpm test:*)",
      "Bash(pnpm audit:*)",
      "Bash(yarn run *)",
      "Bash(bun run *)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint *)",
      "Bash(make *)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(mypy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(bash *check-quality.sh:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git stage:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git am:*)",
      "Bash(git apply:*)",
      "Bash(git update-ref:*)",
      "Bash(git filter-branch:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release delete:*)",
      "Bash(gh secret set:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh workflow run:*)"
    ]
  },
  "outputStyle": "default",
  "spinnerTipsEnabled": true
}
