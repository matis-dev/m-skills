{
  "_comment": "Portable permission allowlist for this skills pack. Copy to .claude/settings.local.json in a new project. Read-only inspection and the standard gate commands are pre-allowed; anything that mutates git is deliberately absent — the skills forbid it and the prompt should stay the backstop.",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(npm run *)",
      "Bash(npm test:*)",
      "Bash(npm audit:*)",
      "Bash(pnpm run *)",
      "Bash(pnpm test:*)",
      "Bash(pnpm audit:*)",
      "Bash(yarn run *)",
      "Bash(bun run *)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint *)",
      "Bash(make *)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(mypy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(bash *check-quality.sh:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "outputStyle": "default",
  "spinnerTipsEnabled": true
}
